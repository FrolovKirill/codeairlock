#!/usr/bin/env python3
"""Operator launcher. Never source .env or read repository files."""
import argparse
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / 'scripts'))
from configure import generate, envfile
from startup import start
from projects import get_project, locked, select_project
from diagnostics import Report, export as export_diagnostics

def run(args): return subprocess.run(args, cwd=ROOT, check=True)
def compose(*args): return run(['docker','compose','-f',str(ROOT/'runtime/compose.json'),*args])

cmd = sys.argv[1] if len(sys.argv)>1 else 'help'
if cmd == 'init':
    envfile(); print('Fill .env locally; secrets must not be pasted into cloud chats.')
elif cmd == 'build':
    run([sys.executable,'scripts/fetch_assets.py'])
    run(['docker','build','-f','deploy/infra.Dockerfile','-t','codeairlock-infra:0.1.0','.'])
    run(['docker','build','-f','deploy/workstation.Dockerfile','-t','codeairlock-workstation:0.1.0','.'])
elif cmd in ('up','demo'):
    parser = argparse.ArgumentParser()
    parser.add_argument('--reindex', action='store_true')
    parser.add_argument('--project')
    parser.add_argument('--index', action='store_true', help='Index before releasing the project-operation lock')
    options = parser.parse_args(sys.argv[2:])
    with locked('operation'), Report(demo=cmd=='demo').run() as report:
        with report.stage('project_selection'):
            project = get_project(options.project) if cmd == 'up' else None
        try:
            start(demo=cmd=='demo', reindex=options.reindex, project=project, report=report)
            if options.index:
                with report.stage('indexing'):
                    run([sys.executable,'scripts/index_project.py'])
            if project:
                with report.stage('project_registration'):
                    select_project(project['id'])
        except BaseException:
            if options.index and (ROOT/'runtime/compose.json').exists():
                try:
                    with report.stage('cleanup'):
                        compose('down','--remove-orphans')
                        (ROOT/'runtime/active-project.json').unlink(missing_ok=True)
                except Exception:
                    print('Cleanup could not finish. Check Docker; containers may remain.', file=sys.stderr)
            raise
elif cmd == 'down':
    with locked('operation'):
        compose('down','--remove-orphans')
        (ROOT/'runtime/active-project.json').unlink(missing_ok=True)
elif cmd == 'projects':
    run([sys.executable,'scripts/project_manager.py',*sys.argv[2:]])
elif cmd == 'fetch': run([sys.executable,'scripts/fetch_assets.py'])
elif cmd == 'search-build':
    from local_search import SEARXNG_IMAGE, PROXY_IMAGE
    run(['docker', 'pull', SEARXNG_IMAGE])
    run(['docker', 'build', '-f', 'deploy/search-proxy.Dockerfile', '-t', PROXY_IMAGE, 'deploy'])
elif cmd == 'status': compose('ps')
elif cmd == 'diagnostics': export_diagnostics()
elif cmd == 'check':
    compose('exec','-T','workstation','python3','/opt/probe.py')
elif cmd == 'audit': run([sys.executable,'scripts/audit_namespaces.py'])
elif cmd == 'index':
    with locked('operation'):
        run([sys.executable,'scripts/index_project.py'])
elif cmd == 'verify-demo': run([sys.executable,'scripts/verify_demo.py'])
elif cmd == 'verify-connected-demo': run([sys.executable,'scripts/verify_demo.py','--real-model'])
elif cmd == 'shell': compose('exec','workstation','bash')
elif cmd == 'search': compose('exec','-T','gateway','python3','/opt/search_admin.py',*sys.argv[2:])
elif cmd == 'model-status': compose('exec','-T','gateway','python3','-c',
    'import sys,json; sys.path.insert(0,"/opt"); from search_admin import call; print(json.dumps(call("GET","/model-status"),indent=2))')
elif cmd == 'logs': compose('logs','--tail','80',*(sys.argv[2:] or ['workstation']))
else:
    print('up/demo --reindex: explicitly create a fresh semantic index; preserve sessions and old indexes.')
    print('Usage: ./codeairlock projects|init|fetch|build|search-build|demo|up|down|status|check|audit|index|model-status|verify-demo|verify-connected-demo|shell|diagnostics|logs [service]|search list|search approve ID|search deny ID')
