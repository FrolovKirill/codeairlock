# Values are parsed as plain text, NEVER executed as shell code. No quotes needed.
# All /v1 base URLs, including Ollama's OpenAI-compatible API.
LLM_BASE_URL=http://llm.internal:11434/v1
LLM_IP=10.0.0.10
# Optional explicit exception: repeat a trusted public model-server IP (HTTPS:443 only).
LLM_TRUSTED_PUBLIC_IP=
LLM_MODEL=REPLACE_ME
LLM_API_KEY=
LLM_CONTEXT=32768
LLM_MAX_OUTPUT=4096
EMBED_BASE_URL=http://embeddings.internal:8080/v1
EMBED_IP=10.0.0.11
EMBED_TRUSTED_PUBLIC_IP=
EMBED_MODEL=REPLACE_ME
# Empty EMBED_API_KEY inherits LLM_API_KEY only when both base URLs are identical.
EMBED_API_KEY=
# Automatically detected at startup. Optional expected length; mismatch stops startup.
EMBED_DIMENSION=
# Bump this label if weights change behind the same model name/endpoint.
EMBED_REVISION=
# Pin actual internal IPv4 addresses; no runtime DNS. HTTPS verifies hostname + CA.
# Optional absolute path to your PEM CA bundle. Never disable certificate checks.
CA_BUNDLE=
# Add/select folders and access modes in ./codeairlock projects.
# Legacy settings below are imported ONCE if runtime/projects.json does not exist.
# REPO_PATH=/absolute/path/to/repository
# REPO_ACCESS=read-only
UI_PORT=6080
# Optional internal SearxNG /search endpoint. JSON format must be enabled.
# Disabled until SEARCH_BASE_URL and SEARCH_IP are set. EVERY request needs host approval.
SEARCH_BASE_URL=
SEARCH_IP=
